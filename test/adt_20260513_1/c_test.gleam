import adt_20260513_1/c

pub fn c_test() {
  assert c.solve(
      #([1, 3, 5], [
        [2, 2],
        [2, 3],
        [1, 3, 0],
        [2, 3],
        [1, 2, 8],
        [2, 2],
        [2, 1],
      ]),
    )
    == [3, 5, 0, 8, 1]

  assert c.solve(
      #([22, 2, 16, 7, 30], [
        [1, 4, 0],
        [1, 5, 0],
        [2, 2],
        [2, 3],
        [2, 4],
        [2, 5],
        [1, 4, 100],
        [1, 5, 100],
        [2, 3],
        [2, 4],
      ]),
    )
    == [2, 16, 0, 0, 16, 100]

  assert c.solve(
      #([478, 369, 466, 343, 541, 42, 165], [
        [2, 1],
        [1, 7, 729],
        [1, 6, 61],
        [1, 6, 838],
        [1, 3, 319],
        [1, 4, 317],
        [2, 4],
        [1, 1, 673],
        [1, 3, 176],
        [1, 5, 250],
        [1, 1, 468],
        [2, 6],
        [1, 7, 478],
        [1, 5, 595],
        [2, 6],
        [1, 6, 599],
        [1, 6, 505],
        [2, 3],
        [2, 5],
        [2, 1],
      ]),
    )
    == [478, 317, 838, 838, 176, 595, 468]
}
